# Local .terraform directories (provider plugins, modules, etc.)
**/.terraform/*

# Exclude Terraform state files (contain sensitive runtime data)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude variable definition files that may contain secrets
*.tfvars
*.tfvars.json
*.auto.tfvars

# Ignore local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Exclude Terraform plan files
*.tfplan

# Ignore Terraform CLI configuration files
.terraformrc
terraform.rc

# Exclude lock file (auto-generated; optional to include)
.terraform.lock.hcl

# System files and OS-specific clutter
.DS_Store
Thumbs.db

# Editor/IDE specific
.vscode/
.idea/

# Environment-specific files
.envrc
.env
